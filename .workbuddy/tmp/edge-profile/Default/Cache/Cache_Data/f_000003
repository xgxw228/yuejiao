<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>账号登录 · 粤教服务智能助手</title>
<style>
  :root {
    --blue: #2f7ef6;
    --blue-dark: #1d63d8;
    --blue-weak: #f2f7ff;
    --line: #e3e6ec;
    --line-focus: #9dc2ff;
    --text: #1a1f29;
    --soft: #6b7280;
    --faint: #9aa1ac;
    --red: #e5484d;
  }

  * { box-sizing: border-box; }

  html, body { margin: 0; height: 100%; }

  body {
    display: flex;
    background: #fff;
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
      "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
    font-size: 14px;
    -webkit-font-smoothing: antialiased;
  }

  button, input { font-family: inherit; }

  /* ---------------- 左侧品牌区 ---------------- */
  .brand-side {
    position: relative;
    width: 46%;
    min-width: 420px;
    max-width: 720px;
    padding: 56px 56px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(900px 520px at 12% 18%, rgba(58, 124, 255, .55), transparent 62%),
      radial-gradient(700px 480px at 78% 88%, rgba(24, 66, 168, .55), transparent 60%),
      linear-gradient(150deg, #10306e 0%, #0b1f4b 42%, #061024 100%);
  }
  .brand-side::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: 46px 46px;
    mask-image: radial-gradient(circle at 30% 40%, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .brand-mark {
    width: 54px; height: 54px;
    border-radius: 15px;
    display: grid; place-items: center;
    font-size: 26px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.18);
    backdrop-filter: blur(6px);
    margin-bottom: 26px;
  }

  .brand-title { font-size: 26px; font-weight: 680; letter-spacing: .4px; }
  .brand-sub {
    margin-top: 12px;
    font-size: 13.5px;
    line-height: 1.8;
    color: rgba(255,255,255,.62);
    letter-spacing: .2px;
  }

  .brand-points { margin: 34px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 16px; }
  .brand-points li {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    font-size: 13.5px;
    color: rgba(255,255,255,.86);
    line-height: 1.55;
  }
  .brand-points svg { flex: 0 0 auto; margin-top: 2px; opacity: .72; }
  .brand-points b { font-weight: 600; color: #fff; }

  .brand-agents {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 40px;
    padding-top: 26px;
    border-top: 1px solid rgba(255,255,255,.1);
  }
  .brand-agents span {
    font-size: 11.5px;
    color: rgba(255,255,255,.72);
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 999px;
    padding: 6px 12px;
    letter-spacing: .2px;
  }

  .brand-foot {
    position: absolute;
    left: 56px;
    bottom: 38px;
    font-size: 12.5px;
    color: rgba(255,255,255,.5);
  }
  .guest-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: rgba(255,255,255,.78);
    text-decoration: none;
    cursor: pointer;
    font-size: 12.5px;
    border: none;
    background: none;
    padding: 0;
  }
  .guest-link:hover { color: #fff; }

  /* ---------------- 右侧表单区 ---------------- */
  .form-side {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 32px;
    background: #fff;
  }
  .form-box { width: 100%; max-width: 408px; }

  .form-title { font-size: 25px; font-weight: 680; letter-spacing: .3px; }
  .form-sub { margin-top: 9px; font-size: 12.5px; color: var(--soft); }

  .field { margin-top: 22px; }
  .field-label { font-size: 12.5px; color: #3d4450; margin-bottom: 8px; }
  .field-label i { color: var(--red); font-style: normal; margin-right: 3px; }

  .input-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #fff;
    transition: border-color .15s, box-shadow .15s;
  }
  .input-wrap:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(47,126,246,.13); }
  .input-wrap.err { border-color: #f0b4b6; box-shadow: 0 0 0 3px rgba(229,72,77,.1); }
  .input-wrap svg { flex: 0 0 auto; color: #b3b9c4; }
  .input-wrap:focus-within svg { color: var(--blue); }

  .input-wrap input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font-size: 13.5px;
    color: var(--text);
    background: transparent;
    height: 100%;
  }
  .input-wrap input::placeholder { color: #b7bdc7; }

  .eye {
    flex: 0 0 auto;
    border: none;
    background: none;
    padding: 2px;
    cursor: pointer;
    color: #b3b9c4;
    display: grid;
    place-items: center;
  }
  .eye:hover { color: #6b7280; }

  .submit {
    width: 100%;
    height: 44px;
    margin-top: 26px;
    border: none;
    border-radius: 8px;
    background: var(--blue);
    color: #fff;
    font-size: 14px;
    font-weight: 560;
    letter-spacing: .5px;
    cursor: pointer;
    transition: background .15s, transform .1s;
  }
  .submit:hover { background: var(--blue-dark); }
  .submit:active { transform: translateY(1px); }
  .submit:disabled { background: #b9cbef; cursor: not-allowed; }

  .form-msg {
    margin-top: 12px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--red);
    min-height: 18px;
  }
  .form-msg.ok { color: #0f7b45; }

  .reg-line {
    margin: 14px 0 0;
    text-align: center;
    font-size: 12.5px;
    color: var(--faint);
  }
  .reg-line a { color: var(--blue); text-decoration: none; cursor: pointer; }
  .reg-line a:hover { text-decoration: underline; }

  .roles-label {
    margin: 26px 0 10px;
    text-align: center;
    font-size: 12px;
    color: var(--faint);
    letter-spacing: .3px;
  }

  .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .role-card {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    padding: 11px 12px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: #fff;
    text-align: left;
    cursor: pointer;
    transition: border-color .14s, box-shadow .14s, background .14s;
  }
  .role-card:hover { border-color: #c3d3f2; background: #fbfcff; }
  .role-card.wide { grid-column: span 2; }
  .role-card.on {
    border-color: var(--blue);
    background: var(--blue-weak);
    box-shadow: 0 0 0 2px rgba(47,126,246,.12);
  }
  .role-icon {
    flex: 0 0 auto;
    width: 26px; height: 26px;
    border-radius: 7px;
    display: grid; place-items: center;
    font-size: 14px;
    background: #f2f4f8;
    margin-top: 1px;
  }
  .role-card.on .role-icon { background: #e3edff; }
  .role-name { display: block; font-size: 13px; font-weight: 620; color: #232935; }
  .role-desc { display: block; font-size: 11px; color: var(--faint); margin-top: 4px; line-height: 1.5; }

  .foot-note {
    margin-top: 24px;
    text-align: center;
    font-size: 11.5px;
    color: #b6bcc6;
  }

  /* ---------------- 提示条 ---------------- */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 34px;
    transform: translate(-50%, 12px);
    background: #1f2937;
    color: #fff;
    font-size: 12.5px;
    padding: 9px 16px;
    border-radius: 9px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s, transform .2s;
    max-width: 84vw;
    z-index: 50;
  }
  .toast.on { opacity: 1; transform: translate(-50%, 0); }
  .toast.err { background: #b42318; }

  .shake { animation: shake .32s; }
  @keyframes shake {
    25% { transform: translateX(-4px); }
    50% { transform: translateX(4px); }
    75% { transform: translateX(-2px); }
  }

  @media (max-width: 1000px) {
    .brand-side { display: none; }
    .form-side { padding: 32px 22px; }
  }
</style>
</head>
<body>

<section class="brand-side">
  <div class="brand-mark">🎓</div>
  <div class="brand-title">粤教服务智能助手</div>
  <div class="brand-sub">留学规划 · 课程与关怀 · 客户跟进，一个对话入口全搞定</div>

  <ul class="brand-points">
    <li>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="1.2" y="2.6" width="13.6" height="9.6" rx="2" stroke="currentColor" stroke-width="1.2"/>
        <path d="M4.6 14.2h6.8M8 12.4v1.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        <path d="M4.8 6.4h3.4M4.8 8.8h6.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span>登录进聊天框，<b>口语化提问即可办理业务</b></span>
    </li>
    <li>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="5.2" r="2.7" stroke="currentColor" stroke-width="1.2"/>
        <path d="M2.6 14c.7-2.9 2.8-4.3 5.4-4.3s4.7 1.4 5.4 4.3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span>后台按角色隔离：<b>留学生 / 员工 / 班主任 / 管理员 / 家长</b></span>
    </li>
    <li>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 7V5.2a4 4 0 0 1 8 0V7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
        <rect x="2.6" y="7" width="10.8" height="7" rx="2" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <span>聊天中执行操作<b>按本人身份落库</b>，不串数据</span>
    </li>
  </ul>

  <div class="brand-agents">
    <span>🎓 留学生智能管家</span>
    <span>💼 员工业务助手</span>
    <span>🤝 客服与活动助手</span>
  </div>

  <div class="brand-foot">
    <button class="guest-link" id="guest">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M9.6 2.4 4 8l5.6 5.6" stroke="currentColor" stroke-width="1.4"
          stroke-linecap="round" stroke-linejoin="round" transform="rotate(180 8 8)"/>
      </svg>
      先以游客身份逛逛公开咨询
    </button>
  </div>
</section>

<section class="form-side">
  <form class="form-box" id="form" autocomplete="on">
    <div class="form-title">账号登录</div>
    <div class="form-sub">选择下方角色可自动填入演示账号</div>

    <div class="field">
      <div class="field-label"><i>*</i>用户名</div>
      <div class="input-wrap" id="user-wrap">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="5.2" r="2.7" stroke="currentColor" stroke-width="1.3"/>
          <path d="M2.6 14c.7-2.9 2.8-4.3 5.4-4.3s4.7 1.4 5.4 4.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
        </svg>
        <input id="username" name="username" placeholder="admin" autocomplete="username" spellcheck="false" />
      </div>
    </div>

    <div class="field">
      <div class="field-label"><i>*</i>密码</div>
      <div class="input-wrap" id="pwd-wrap">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M4.2 7.1V5.3a3.8 3.8 0 0 1 7.6 0v1.8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <rect x="2.6" y="7.1" width="10.8" height="6.9" rx="2" stroke="currentColor" stroke-width="1.3"/>
        </svg>
        <input id="password" name="password" type="password" placeholder="123456" autocomplete="current-password" />
        <button class="eye" type="button" id="eye" title="显示/隐藏密码" aria-label="显示密码">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M1.6 8s2.3-4.1 6.4-4.1S14.4 8 14.4 8 12.1 12.1 8 12.1 1.6 8 1.6 8Z"
              stroke="currentColor" stroke-width="1.2"/>
            <circle cx="8" cy="8" r="1.9" stroke="currentColor" stroke-width="1.2"/>
          </svg>
        </button>
      </div>
    </div>

    <button class="submit" id="submit" type="submit">登录</button>
    <div class="form-msg" id="msg"></div>

    <p class="reg-line">还没有家长账号？<a id="register">注册家长账号</a></p>

    <div class="roles-label">演示角色（点击填入）</div>
    <div class="roles" id="roles"></div>

    <div class="foot-note">演示环境 · 密码统一 123456 · 数据每次演示前可重置</div>
  </form>
</section>

<div class="toast" id="toast"></div>

<script>
(function () {
  "use strict";

  var TOKEN_KEY = "yj_token";
  var USER_KEY = "yj_user";
  var NEXT = new URLSearchParams(location.search).get("next") || "/demo/";
  var FORCE_LOGOUT = new URLSearchParams(location.search).has("logout");

  var el = {
    form: document.getElementById("form"),
    username: document.getElementById("username"),
    password: document.getElementById("password"),
    userWrap: document.getElementById("user-wrap"),
    pwdWrap: document.getElementById("pwd-wrap"),
    eye: document.getElementById("eye"),
    submit: document.getElementById("submit"),
    msg: document.getElementById("msg"),
    roles: document.getElementById("roles"),
    guest: document.getElementById("guest"),
    register: document.getElementById("register"),
    toast: document.getElementById("toast"),
  };

  var toastTimer = null;
  function toast(text, isErr) {
    el.toast.textContent = text;
    el.toast.classList.toggle("err", !!isErr);
    el.toast.classList.add("on");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { el.toast.classList.remove("on"); }, 2800);
  }

  function setMsg(text, ok) {
    el.msg.textContent = text || "";
    el.msg.classList.toggle("ok", !!ok);
  }

  /* ---------- 已登录直接进控制台 ---------- */
  if (!FORCE_LOGOUT) {
    var saved = localStorage.getItem(TOKEN_KEY);
    if (saved) {
      fetch("/api/auth/me", { headers: { Authorization: "Bearer " + saved } })
        .then(function (r) { return r.json().then(function (d) { return r.ok ? d.data : null; }); })
        .then(function (user) {
          if (user) location.replace(NEXT);
          else localStorage.removeItem(TOKEN_KEY);
        })
        .catch(function () {});
    }
  } else {
    localStorage.removeItem(TOKEN_KEY);
    localStorage.removeItem(USER_KEY);
  }

  /* ---------- 角色卡 ---------- */
  var cards = [];
  var order = ["admin", "teacher", "staff", "student", "parent"];

  function renderRoles(list) {
    cards = list.slice().sort(function (a, b) {
      return order.indexOf(a.key) - order.indexOf(b.key);
    });
    el.roles.innerHTML = "";
    cards.forEach(function (r) {
      var b = document.createElement("button");
      b.type = "button";
      b.className = "role-card" + (r.key === "admin" ? " wide" : "");
      b.setAttribute("data-role", r.key);
      b.innerHTML =
        '<span class="role-icon">' + r.icon + "</span>" +
        "<span><span class=\"role-name\">" + r.label + " · " + r.name + "</span>" +
        '<span class="role-desc">' + r.desc + "</span></span>";
      b.addEventListener("click", function () { fill(r); });
      el.roles.appendChild(b);
    });
  }

  function fill(role) {
    el.username.value = role.username;
    el.password.value = role.password;
    clearErr();
    setMsg("已填入「" + role.label + "」演示账号：" + role.username + " / " + role.password, true);
    Array.prototype.forEach.call(el.roles.children, function (c) {
      c.classList.toggle("on", c.getAttribute("data-role") === role.key);
    });
    el.submit.focus();
  }

  function clearErr() {
    el.userWrap.classList.remove("err");
    el.pwdWrap.classList.remove("err");
  }

  fetch("/api/auth/roles")
    .then(function (r) { return r.json(); })
    .then(function (d) { if (d && d.data && d.data.length) renderRoles(d.data); })
    .catch(function () { toast("读取演示角色失败，可手动输入账号", true); });

  /* ---------- 密码显隐 ---------- */
  el.eye.addEventListener("click", function () {
    var show = el.password.type === "password";
    el.password.type = show ? "text" : "password";
    el.eye.style.color = show ? "#2f7ef6" : "";
  });

  /* ---------- 登录 ---------- */
  function doLogin(username, password, silent) {
    var u = (username || el.username.value).trim();
    var p = password || el.password.value;
    clearErr();
    setMsg("");

    if (!u) { el.userWrap.classList.add("err"); setMsg("请输入用户名"); el.form.classList.add("shake"); setTimeout(function () { el.form.classList.remove("shake"); }, 340); return; }
    if (!p) { el.pwdWrap.classList.add("err"); setMsg("请输入密码"); return; }

    el.submit.disabled = true;
    el.submit.textContent = "登录中…";

    fetch("/api/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ username: u, password: p }),
    })
      .then(function (r) {
        return r.json().then(function (d) {
          if (!r.ok) throw new Error(d.detail || d.msg || ("HTTP " + r.status));
          return d;
        });
      })
      .then(function (d) {
        var data = d.data || {};
        localStorage.setItem(TOKEN_KEY, data.token);
        localStorage.setItem(USER_KEY, JSON.stringify(data.user || {}));
        setMsg(d.msg || "登录成功，正在进入…", true);
        if (silent) setMsg("已按游客身份进入…", true);
        location.replace(NEXT);
      })
      .catch(function (e) {
        el.submit.disabled = false;
        el.submit.textContent = "登录";
        setMsg(e.message || "登录失败");
        el.form.classList.add("shake");
        setTimeout(function () { el.form.classList.remove("shake"); }, 340);
      });
  }

  el.form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    doLogin();
  });

  /* ---------- 游客：直接以家长身份进公开咨询 ---------- */
  el.guest.addEventListener("click", function () {
    var parent = cards.filter(function (c) { return c.key === "parent"; })[0];
    if (parent) {
      el.username.value = parent.username;
      el.password.value = parent.password;
      doLogin(parent.username, parent.password, true);
    } else {
      doLogin("parent001", "123456", true);
    }
  });

  el.register.addEventListener("click", function () {
    toast("演示环境不开放注册，用下方「家长」角色卡可直接体验");
  });

  el.username.addEventListener("input", clearErr);
  el.password.addEventListener("input", clearErr);
  el.username.focus();
})();
</script>
</body>
</html>
