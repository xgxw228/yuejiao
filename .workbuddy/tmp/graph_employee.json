     }
    },
    "classes": [
     {
      "id": "c_query",
      "name": "业务查询与催办：查客户档案与跟进记录、学生成绩、请假审批进度、员工日报、投诉工单、心理预警、活动名额；也包括「把张三的请假批了」「这条投诉标记为已解决」这类要改数据的话（系统不直接执行，会说明该去哪办），例如「许同学跟进到哪一步了」「张三雅思听力多少分」「昨天日报写了什么」「有哪些待处理的投诉」"
     },
     {
      "id": "c_lead_create",
      "name": "客户录入：录入新的意向客户、新建销售线索，话里带姓名和背景信息，例如「新录入一个客户，叫陈晨，19岁，家长电话13800138000」"
     },
     {
      "id": "c_lead_status",
      "name": "客户状态流转：只处理客户档案的状态字段，话里必须出现「改成/改为/设为」+ 已签约/跟进中/新增意向/已流失之一，例如「把许明的状态改成已签约」。请假审批、投诉处理、成绩修改都不属于这一类"
     },
     {
      "id": "c_daily_report",
      "name": "写日报：让你把他的工作整理成日报或周报并保存，例如「帮我写今天的日报：跟进了5个客户，签约1个」。注意：只是查昨天日报写了什么属于业务查询"
     },
     {
      "id": "c_score_entry",
      "name": "成绩录入：给某个学生录入某门课的成绩，话里必须同时有学生姓名、课程名和具体分数，例如「给张三录入Python课程成绩92分」"
     },
     {
      "id": "c_alert_handle",
      "name": "预警处理：要给某个学生的心理预警改状态（认领、跟进、解除），话里出现学生姓名 + 状态变化，例如「把许明的预警标记为跟进中」「张三的预警解除掉」。注意：只是查有哪些预警属于业务查询"
     },
     {
      "id": "c_handbook",
      "name": "公司制度与新人指引：组织架构、报销流程、入职材料、办公设施、IT 支持、公司介绍、常见问题"
     },
     {
      "id": "c_other",
      "name": "其他：与业务无关的问题（天气、写代码、闲聊），或要密钥、密码、数据库连接串这类不该给的东西，或系统明显办不到的请求"
     }
